// Inventory tables — see findCar-schema.md, part D (fields) and part E (translation rules).
// Names are snake_case everywhere: document = database = code. No @map.
// Required only where a row without the value is meaningless (part E, rule 3).
// Day 5 (31/08–01/09): shaped to the Ministry of Transport data as it actually is.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. models — one row per catalog entry. The ministry's key is (vehicle_class, tozeret_cd, degem_cd, year):
// degem numbers are counted separately for private (P) and commercial (M) vehicles — never reused within a class.
// Within a class, a pair is one fixed spec across all its years (0/52,257 conflicts); the year is the catalog's grain.
model models {
  id               Int      @id @default(autoincrement())
  vehicle_class    String? // catalog/registry sug_degem: "P" private | "M" commercial. Part of the identity.
  degem_code       String? // "tozeret_cd-degem_cd", e.g. "588-182". Normalized by makeDegemCode. May be empty.
  year             Int? // production year — part of the identity. cars.year is the car's own year, used to pick this row.
  comparison_group String? // level-1 group key computed from the catalog (make|model|body|fuel|cc|hp|gearbox|drive|trim); year is NOT part of it
  make             String? // catalog: tozar
  model            String? // catalog: kinuy_mishari, normalized ("MAZDA 3" / "MAZDA3" -> one spelling)
  sub_model        String? // catalog: ramat_gimur
  engine_size      Int? // cc, catalog: nefah_manoa
  fuel_type        String? // catalog: delek_nm
  transmission     String? // code: auto | manual (catalog: automatic_ind)
  drive_type       String? // catalog: hanaa_nm
  body_type        String? // catalog: merkav
  seats            Int? // catalog: mispar_moshavim
  horsepower       Int? // catalog: koah_sus
  safety_rating    Int? // catalog: ramat_eivzur_betihuty (0–8)
  doors            Int? // catalog: mispar_dlatot; 0 = no data (old rows)
  airbags          Int? // catalog: mispar_kariot_avir; null = the row has no catalog spec data
  drive_technology String? // code: regular | hybrid | plug_in | electric (catalog: technologiat_hanaa_nm)
  co2_wltp         Int? // g CO2 per km in the WLTP test (catalog: CO2_WLTP, never kamut_CO2); null when the version did not pass that test — almost every version before ~2019, and US-standard versions; then the consumption comes from the manual spec (model_specs)
  // the 15 catalog flags (0/1 in the catalog), in the section's display order: 1-12 the driver-assist row, 13-15 the equipment row
  aeb_pedestrian_cyclist    Boolean? // blimat_hirum_lifnei_holhei_regel_ofanaim
  pedestrian_detection      Boolean? // zihuy_holchey_regel_ind
  two_wheeler_detection     Boolean? // zihuy_rechev_do_galgali
  forward_collision_warning Boolean? // zihuy_matzav_hitkarvut_mesukenet_ind
  distance_monitoring       Boolean? // nitur_merhak_milfanim_ind
  lane_departure_warning    Boolean? // bakarat_stiya_menativ_ind
  lane_keeping              Boolean? // bakarat_stiya_activ_s
  blind_spot_detection      Boolean? // zihuy_beshetah_nistar_ind
  adaptive_cruise           Boolean? // bakarat_shyut_adaptivit_ind
  traffic_sign_recognition  Boolean? // zihuy_tamrurey_tnua_ind
  auto_high_beams           Boolean? // shlita_automatit_beorot_gvohim_ind
  reverse_auto_braking      Boolean? // blima_otomatit_nesia_leahor
  sunroof                   Boolean? // halon_bagg_ind
  alloy_wheels              Boolean? // galgaley_sagsoget_kala_ind
  reverse_camera            Boolean? // matzlemat_reverse_ind
  import_type      String? // source unknown yet (check 5 half-open). Empty.
  model_spec_id    Int? // -> model_specs; set by the sheet import; null = no manual spec yet -> the alert list
  family_id        Int? // Day 18: which model-as-a-person-knows-it this catalog row belongs to; null = outside the reviewed scope
  created_at       DateTime @default(now()) @db.Timestamptz(3)

  family model_families? @relation(fields: [family_id], references: [id], onDelete: SetNull)
  spec   model_specs?    @relation(fields: [model_spec_id], references: [id], onDelete: SetNull)
  cars   cars[]

  @@unique([vehicle_class, degem_code, year])
}

// 2. cars — the physical car, one row per license plate. No price, no seller, no declared km.
model cars {
  id                  Int       @id @default(autoincrement())
  license_plate       String?   @unique // external id, the anchor. Digits only, kept as text.
  model_id            Int // required: without a variant there is no comparison group
  year                Int? // production year, registry shnat_yitzur. Picks the models row and slices the medians.
  hand                Int? // non-dealer rows in ownership history; null when history is empty or truncated
  ownership_history   Json? // [{ ym: "2018-03", type: "leasing" }, ...] all rows incl. dealer, oldest first
  color               String? // from the ad; Ministry as fallback. A listing fills empty, never overwrites.
  test_expiry         DateTime? @db.Date
  mivchan_acharon_dt  DateTime? @db.Date // date of last test (registry; snapshot at import)
  km_at_last_test     Int? // odometer at last test (history 1; snapshot at import; null pre-2017)
  first_registration  DateTime? @db.Date // history 1 full date; fallback registry month with day 01
  // Future sources (leasing companies, disclosure form). Empty for now; null = unknown.
  had_accident        Boolean?
  damage_severity     String?
  service_history     String?
  authorized_garage   Boolean?
  previous_owners     Int?
  is_original         Boolean?
  warranty_until      DateTime? @db.Date
  test_failures       Int?
  // Day 14 run C (§0.10): the registry refresh's two columns.
  registry_checked_at DateTime? @db.Timestamptz(3) // when the Ministry's answer on this car was last ACCEPTED (not when we last asked). Backfilled from created_at.
  cancelled_at        DateTime? @db.Date // bitul_dt, written once when the car resolves to the cancellations registry. Empty today (0 cars).
  // Day 18: three registry fields read from the active / inactive record and history 1. Written at import and refresh; existing cars backfilled from the raw cache.
  current_owner_type  String? // the registry's current holder type (baalut), translated in translator.ts to the same codes as ownership_history[].type
  registry_color      String? // tzeva_rechev, as the source gave it
  color_changed       Boolean? // history 1: shnui_zeva_ind (cars registered from 2017 only); null = unknown, which is the truth for pre-2017 cars
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  model         models              @relation(fields: [model_id], references: [id])
  listings      listings[]
  test_readings car_test_readings[]
  events        events[]
}

// 3. listings — one row per offer to sell a specific car. The score lives here.
// live = delisted_at IS NULL (the pass writes the timestamps only); display is a rule on the dealer's agreement status.
model listings {
  id                   Int       @id @default(autoincrement())
  car_id               Int // required: an offer without a car is not an offer
  dealer_id            Int // required: decides where the lead goes and who is billed
  source               String // code: yad2 | albar | ... Derived from the link at import.
  external_id          String // the listing's id in the source system, without the "?" tail
  public_id            String    @unique // Day 19 (Run 6a): the listing's id in every address the site shows (/listing/<public_id>) — random, 10 chars of [a-z0-9], minted once at insert by newPublicId() (src/lib/public-id.ts); never changes, carries no meaning. The serial id and the licence plate never appear in an address.
  price                Int // required: asking price, NIS
  region               String? // one of the eight areas, Hebrew text (findCar-now.md "המיקום"): derived from city at import, or as the sheet gave it on old rows. The filter chips and stored questions read it. Written once at insert, never updated
  city                 String? // Day 19b (Run 20): the city the ad is in, as the CBS localities file spells it, cleaned (findCar-schema.md §3). Filled once by the sheet import when the ad enters (Run 22); null on the old manual rows, which came with an area. Shown on the car page and in the contact window; the filters read region
  image_urls           String[] // addresses of images, not images. Empty in the manual phase.
  km_declared          Int? // what THIS ad says. Another ad for the same car may say otherwise.
  hand_declared        Int? // hand per the ad. Empty if the ad does not state it.
  km_observed_at       DateTime  @db.Timestamptz(3) // Day 19 (engine v5): the day km_declared was observed — the first sighting, then the day of each km change. Written only by the import's insert and by observe.ts.
  disclosure_provided  Boolean   @default(false) // data came from a disclosure form
  first_seen_at        DateTime  @db.Timestamptz(3) // required: the one value that cannot be recovered later
  last_verified_at     DateTime? @db.Timestamptz(3)
  delisted_at          DateTime? @db.Timestamptz(3)
  // Stage A — precomputed against the comparison group's median.
  score                Float? // the deal score (Day 11: price_advantage + condition_vs_typical)
  score_breakdown      Json? // the whole ScoreResult of src/lib/scoring — Day 14 run B: the only place the condition sum and the confidence level live
  engine_version       Int? // Day 11: null until first scored
  owners_at_first_seen Int? // Day 11: rows in the car's ownership_history when the listing was first seen
  scored_at            DateTime? @db.Timestamptz(3)
  market_stats_id      Int? // which median row the current score was computed against. Empty until the first score.
  model_stats_id       Int? // Day 14: which model_stats row (the km slope) the current score used
  pool_stats_id        Int? // Day 14: which pool_stats row (the anchor curve) the current score used
  created_at           DateTime  @default(now()) @db.Timestamptz(3)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(3) // Day 19 (Run 6a): stamped by the DATABASE on every insert and update (trigger set_updated_at, clock_timestamp()) — whoever writes: Prisma, raw SQL or a hand edit. One of the "update" signals of the stored-search rule (findCar-now.md).

  car            cars                  @relation(fields: [car_id], references: [id])
  dealer         dealers                 @relation(fields: [dealer_id], references: [id])
  market_stats   market_stats?           @relation(fields: [market_stats_id], references: [id])
  model_stats    model_stats?            @relation(fields: [model_stats_id], references: [id])
  pool_stats     pool_stats?             @relation(fields: [pool_stats_id], references: [id])
  scores         listing_scores[]
  price_history  listing_price_history[]
  search_results search_results[]
  events         events[]
  contact_requests contact_requests[]

  @@unique([source, external_id])
  @@index([market_stats_id])
}

// 4. dealers — whoever offers cars: lots, leasing and rental companies, importers, private sellers.
// Identification (findCar-schema.md §4): feed identity (later); in the demo a business seller by normalized name, then an identical phone as evidence; a private seller = a new row per listing. No region on the dealer — the location is the listing's (city, region).
model dealers {
  id                  Int       @id @default(autoincrement())
  corp_id             String?   @unique // corporate registry number from the dealers list. Empty: private person or not found.
  name                String // required
  dealer_type         String // required. code: lot | leasing | rental | importer | private. Source: the listing/feed, not the registry.
  phone               String? // normalized digits; second identification key, the only one for private sellers
  in_dealer_registry  Boolean? // found in the licensed-dealers list? null = not checked yet
  registry_checked_at DateTime? @db.Timestamptz(3) // when last checked against the list (the list changes)
  feed_updated_at     DateTime? @db.Timestamptz(3) // empty until there is a feed
  created_at          DateTime  @default(now()) @db.Timestamptz(3)

  listings   listings[]
  commercial dealer_commercial[]
}

// 5. dealer_commercial — one row per AGREEMENT PERIOD (history kept). Open row = agreement_end null;
// at most one open row per dealer (enforced in the writing code). "No agreement" = no open row.
// Commercial data reaches the engine in exactly one place: the stage-B eligibility rule
// dealer_not_visible, which can only exclude a listing, never move it.
model dealer_commercial {
  id                 Int       @id @default(autoincrement())
  dealer_id          Int // not unique: one row per agreement period
  agreement_status   String // required. code: demo | trial | active | suspended
  price_per_lead     Decimal?  @db.Decimal(10, 2) // snapshot of the signed price, NIS
  price_locked_until DateTime? @db.Date
  free_until         DateTime? @db.Date
  dedup_window_days  Int?
  terms_version      Int?
  agreement_start    DateTime? @db.Date
  agreement_end      DateTime? @db.Date // null = open
  billing_contact    String?
  notes              String?
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(3) // Day 19 (Run 6a): when this agreement row last changed — stamped by the DATABASE on every insert and update (trigger set_updated_at), so a hand edit in the Supabase editor counts. One of the "update" signals of the stored-search rule. Rows that existed at the migration carry the migration's moment.

  dealer dealers @relation(fields: [dealer_id], references: [id])
  contact_requests contact_requests[]
}

// 6. market_stats — the market norm: median price and km per (comparison group × year).
// Computed from listings, never from cars: a car has no price, a listing has one.
// Rows are appended, never overwritten — the current norm is the newest row per group,
// which is what keeps a January score reconstructable through listings.market_stats_id.
model market_stats {
  id               Int      @id @default(autoincrement())
  comparison_group String // the group key (groupKey in src/lib/comparison-group.ts); year is not part of it
  year             Int // the production year this row was computed for — the market prices years separately
  median_price     Int // every listing in the pool contributes price
  median_km        Int? // over km_declared of the same listings; empty when no ad in the pool states km
  sample_size      Int // how many listings the medians rest on — this is what sets the score's confidence
  median_history   Float? // Day 14: median of the on-paper history row over the cell's listings whose car has registry history; null below MIN_SAMPLE such listings. Replaces median_condition (dropped) — the typical is the history row alone.
  window_days      Int // length of the window this row was computed in. 90 normally; a thin cell is widened to 180
  group_version    Int // which definition of the key this row was computed under
  engine_version   Int // which engine computed median_history; 0 = computed before any engine existed
  computed_at      DateTime @default(now()) @db.Timestamptz(3)

  listings       listings[]
  listing_scores listing_scores[]

  @@index([comparison_group, year, computed_at])
}

// 6b. model_stats — the norm one level above the cell: one row per (make, model) per norms run (Day 14, §0.1).
// Holds the model's own km slope, signed as measured (more km → negative). Append-only like market_stats;
// no foreign key to models — the key is the pair of catalog strings, as market_stats keys on the group string.
model model_stats {
  id                Int      @id @default(autoincrement())
  make              String // models.make
  model             String // models.model (normalized spelling)
  km_slope          Float? // percent of value per 1,000 km per year of deviation; null only when nothing could be measured
  km_slope_n        Int // listings in the regression; 0 when km_slope is null. Below KM_SLOPE_MIN_SAMPLE the engine uses the default instead, but the row is written anyway
  km_filter_anchors Json? // Day 15 (§1): the km filter chips — quartiles (P25/P50/P75) of km_declared over ALL live listings of the model, each rounded UP to 10,000, deduplicated, ascending, e.g. [60000, 90000, 120000]. Array of ints; a UI number, never a norm the engine reads. Null on rows written before the column existed
  engine_version    Int
  group_version     Int
  computed_at       DateTime @db.Timestamptz(3) // no default: the norms run writes one `now` for the whole run

  listings       listings[]
  listing_scores listing_scores[]

  @@index([make, model, computed_at])
}

// 6c. pool_stats — the norm above the model: one row per norms run for the whole pool (Day 14, §0.1).
// The anchor curve, ratio = intercept + per_year × age, used for the price row of a thin cell against
// the listing's own new-car price. Append-only. No group_version (P3): the curve is measured per
// model-year, not per cell, so the cell definition does not touch it. All five values null (P4) when
// fewer than 3 model-years have a new-car price and a median.
model pool_stats {
  id                     Int      @id @default(autoincrement())
  anchor_ratio_intercept Float?
  anchor_ratio_per_year  Float?
  anchor_error_pct       Float? // leave-one-out, worst model-year
  anchor_age_min_years   Float? // youngest model-year in the fit
  anchor_age_max_years   Float? // oldest
  anchor_n               Int // model-year POINTS the line was fitted through (the fit's own n)
  anchor_listings        Int // listings behind those points — coverage, not the fit's n
  anchor_points          Json? // Day 18: the fit's model-year points as data, [{ make, model, year, n, ratio, median_age }]. The engine applies the anchor only to a listing whose (make, model, year) is in this list — the gate is the model-year, not an age range. Null on rows written before the column existed
  engine_version         Int
  computed_at            DateTime @db.Timestamptz(3) // no default: the norms run writes one `now` for the whole run

  listings       listings[]
  listing_scores listing_scores[]
}

// 7. listing_scores — one row per listing per scoring run (Day 11, §19.1). listings keeps the latest
// score; this table keeps all of them. Append-only (forbid_change trigger: no UPDATE, no DELETE).
model listing_scores {
  id              Int      @id @default(autoincrement())
  listing_id      Int
  scored_at       DateTime @db.Timestamptz(3) // the run's `now`
  engine_version  Int
  market_stats_id Int?
  model_stats_id  Int? // Day 14: the model_stats row (km slope) this score used
  pool_stats_id   Int? // Day 14: the pool_stats row (anchor curve) this score used
  deal_score      Float?
  breakdown       Json // the full ScoreResult — Day 14 run B: the condition sum and the confidence level are read from here

  listing      listings      @relation(fields: [listing_id], references: [id])
  market_stats market_stats? @relation(fields: [market_stats_id], references: [id])
  model_stats  model_stats?  @relation(fields: [model_stats_id], references: [id])
  pool_stats   pool_stats?   @relation(fields: [pool_stats_id], references: [id])

  @@index([listing_id, scored_at])
}

// 8. listing_price_history — one row per observed price (Day 11, §19.2). The first row is written at
// import with first_seen_at; every later price change goes through recordPrice() in src/lib/price-history.ts,
// which inserts here and then updates listings.price. Append-only (forbid_change trigger).
model listing_price_history {
  id          Int      @id @default(autoincrement())
  listing_id  Int
  price       Int
  observed_at DateTime @db.Timestamptz(3)

  listing listings @relation(fields: [listing_id], references: [id])

  @@index([listing_id, observed_at])
}

// 9. car_test_readings — the tester's odometer readings over time (Day 11, §21). cars keeps the latest
// reading; this table keeps every (car, test date) pair ever read. Append-only (forbid_change trigger).
model car_test_readings {
  id          Int      @id @default(autoincrement())
  car_id      Int
  test_date   DateTime @db.Date // mivchan_acharon_dt as read
  km          Int // km_at_last_test as read
  observed_at DateTime @db.Timestamptz(3) // when we read it

  car cars @relation(fields: [car_id], references: [id])

  @@unique([car_id, test_date])
}

// 10. new_car_prices — the Ministry of Transport new-car price list (Day 12 part 5, §1). One row per (key, publication).
// The file's key is four columns: (tozeret_cd, degem_cd, shnat_yitzur, sug_degem) — the P and M lists reuse code numbers for
// different vehicles. Append-only: a later publication adds rows, nothing is updated or deleted. No column on cars — a car's
// new price is read by the four-column join at read time (models.degem_code + models.vehicle_class + cars.year).
model new_car_prices {
  id            Int      @id @default(autoincrement())
  tozeret_cd    Int
  degem_cd      Int
  degem_code    String // "tozeret_cd-degem_cd" as makeDegemCode builds it (Day 12 part 6) — equals models.degem_code for the join
  shnat_yitzur  Int
  sug_degem     String // 'P' private | 'M' commercial
  semel_yevuan  Int // importer code
  shem_yevuan   String // importer name
  tozeret_nm    String
  degem_nm      String
  kinuy_mishari String?
  mehir         Int // list price, ILS, as published
  published_at  DateTime @db.Date // the dataset's own update date ("עודכן בתאריך"), given on import
  imported_at   DateTime @default(now()) @db.Timestamptz

  @@unique([tozeret_cd, degem_cd, shnat_yitzur, sug_degem, published_at])
  @@index([tozeret_cd, degem_cd, shnat_yitzur, sug_degem])
  @@index([degem_code, sug_degem, shnat_yitzur])
}

// 11. searches — one row per search (findCar-schema.md part A and part D §7). Created on Day 15:
// the table was specified from the start and never built; BRIEF §3.4 writes a row per runSearch()
// invocation, so it is born here. Written in real time by src/lib/search/run.ts — zero manual filling.
// TWO versions, not one: engine_version is Stage A's, rules_version is Stage B's. Without both you
// cannot tell which of them moved a result when they change in the same week.
model searches {
  id             Int      @id @default(autoincrement())
  public_id      String   @unique // Day 19 (Run 6a): the id in the results address (/?s=<public_id>) — random, 10 chars of [a-z0-9], minted at insert by newPublicId(). Only a person's search (rerun_of null) ever appears in an address; a re-run row gets an id too (the column is required) but it is never shown.
  visitor_id     String? // anonymous visitor cookie, 1 year, httpOnly — the same browser and device ACROSS visits
  session_id     String? // one visit; resets between visits
  user_id        Int? // empty as long as there is no login
  model_searched String // required: a search without a model is not a search (the model is the only mandatory field of the screen)
  family_id      Int? // Day 18: the family chosen in the bar; null for searches before the table. model_searched stays
  filters        Json? // the filters exactly as the action received them; null when the search carried none
  priority       String? // code: price | km | condition. Empty when the user skipped it — not recoverable. No screen writes it yet
  engine_version Int // Stage A's version at that moment
  rules_version  Int // Stage B's version at that moment (RULES_VERSION)
  results_count  Int // how many listings entered the ranking
  pool_count     Int? // the cut pool — listings after the filters, before selectThree (the number on the "עדכן" button); results_count keeps its meaning: ranked + tail
  rerun_of       Int? // Day 19 (Run 6a): null = a question a person asked (the search count counts only these). Set = the site re-ran a stored question after an update; it ALWAYS points at the person's search (a row whose own rerun_of is null), never at another re-run. Written from Run 6b on.
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  generator_version Int? // Days 22–23 (Run 4): JUSTIFICATION_GENERATOR_VERSION at this run — the wordings file changes over time, and the version says which one the person saw; null = the search ran before the generator existed (no backfill). Written from Run 5 on

  family         model_families?  @relation(fields: [family_id], references: [id], onDelete: SetNull)
  search_results search_results[]
  original       searches?        @relation("search_reruns", fields: [rerun_of], references: [id], onDelete: NoAction)
  reruns         searches[]       @relation("search_reruns")
  events         events[]

  @@index([rerun_of])
}

// 12. search_results — the full ranking of one search: one row per listing of that search's cut pool
// (findCar-schema.md §D8). Born on Day 15 (BRIEF Run 2a §2), written by src/lib/search/run.ts in the same
// transaction as its searches row — a search row never exists without its rows (zero rows when the pool is
// empty). Each row is a SNAPSHOT: the score, the confidence, the price/km as they were at that moment — plus
// pointers (never copies) to the norm rows, the new-car price row and the listing_scores row, all append-only,
// so a result stays reconstructable after the listing moves or the next norms run lands. The three norm
// columns, new_car_price_id and listing_scores_id are plain nullable ints, not foreign keys (BRIEF §0.2):
// those tables are append-only, so a pointer never dangles.
// No forbid_change trigger (§0.2) — the test rows of Run 2b are deleted by hand, results first, searches second.
model search_results {
  id                        Int      @id @default(autoincrement())
  search_id                 Int // the searches row this belongs to; one row per listing of that search's cut pool
  listing_id                Int // a listing, not a car
  rank                      Int? // the final rank after Stage B, contiguous over the shown listings; null for a merged (duplicate) or excluded listing — the reason is in stage_b_trace. The best_value winner is always 1
  total_score               Float? // snapshot of listings.score at that moment; null when the listing had no deal score (thin cell)
  confidence                String? // score_breakdown.confidence.level at that moment: high | medium | low
  market_stats_id           Int? // snapshot of the three norm pointers on the listing at that moment (pointers, not copies — those tables are append-only)
  model_stats_id            Int?
  pool_stats_id             Int?
  new_car_price_id          Int? // the new_car_prices row that supplied the ceiling's new price; null when the key has no row
  listing_scores_id         Int? // the listing_scores row current at that moment — latest scored_at <= the search's now, ties by id (BRIEF Run 2c §0.5); the invoice lives there, append-only: a pointer, not a copy. Null when the listing was never scored
  recommendation_categories String[] // codes: best_value | peace_of_mind | cheapest — a list, a car may win more than one; empty = not recommended
  stage_b_trace             Json // array of rule records, one fixed shape (findCar-schema.md §D8); full for rank <= TRACE_FULL_RANK (10) or a recommended row, triggered-only for other ranked rows, acted-only (+ triggered) for rank null
  price_snapshot            Int // listings.price at that moment
  km_snapshot               Int? // listings.km_declared at that moment
  sentence_kind             String? // Days 22–23 (Run 4): which case wrote this row's one sentence — the library's SentenceKind codes (src/lib/justification/types.ts): rule_cancelled | rule_no_history | rule_floor | pick_reason | max_effect | no_price_ownership | no_price_km | empty; English codes, the Hebrew lives on the screen only; null = before the generator (no backfill). Written from Run 5 on
  sentence_fact             String? // the fact family the sentence rests on: price | ownership | km | date; null when the sentence is empty, and before the generator
  sentence_text             String? // the sentence exactly as shown — the wordings file changes over time, and the text is what the person saw; null when the sentence is empty, and before the generator
  sentence_values           Json? // the numbers inside the sentence, e.g. { ils, km, one_of, of } — for the measurement queries, without parsing text; null when the sentence carries no number, and before the generator
  cheaper_than_cheapest     Boolean  @default(false) // the recognition tag זול מ"הכי חסכוני" was shown on this row (a list car cheaper than the "הכי חסכוני" pick); false on every row written before the generator
  runner_up_fact            String? // on the runner-up's OWN row: the fact the "הכי חסכוני" card's bar showed about this car; null on every other row, and before the generator

  searches searches @relation(fields: [search_id], references: [id], onDelete: Restrict)
  listings listings @relation(fields: [listing_id], references: [id], onDelete: Restrict)
  contact_requests contact_requests[]

  @@index([search_id])
  @@index([listing_id])
}

// 13. makes — one row per make as the catalog spells it (Day 18). The parent of model_families.
model makes {
  id         Int      @id @default(autoincrement())
  name_en    String   @unique // = models.make
  name_he    String
  aliases    String[]
  created_at DateTime @default(now()) @db.Timestamptz(3)

  families model_families[]
}

// 14. model_families — the model as a person knows it (Day 18). Catalog rows (models.family_id) and searches
// (searches.family_id) point here; one family per (make, name_en).
model model_families {
  id         Int      @id @default(autoincrement())
  make_id    Int
  name_en    String
  name_he    String
  aliases    String[]
  created_at DateTime @default(now()) @db.Timestamptz(3)

  make     makes      @relation(fields: [make_id], references: [id])
  models   models[]
  searches searches[]

  @@unique([make_id, name_en])
}

// 15. events — one row per user action (findCar-schema.md part A "events" and part D §9). Born on Day 19ב, the
// contact-window run: only the window's four actions are written for now — contact_opened | contact_form_started |
// contact_form_error | contact_closed; every other action on the site joins on Days 27–28 (new actions add codes,
// and keys inside details — not columns). search_results keeps what the ENGINE decided; this table keeps what the
// PERSON did — crossing the two is the measurement. The buyer's sent request is NOT an event: it is a
// contact_requests row, which points at its opening row here. Closed to Supabase's open API: row level security
// on, no policy — only the site's server reads and writes (the two ALTER lines at the end of the migration;
// Prisma has no syntax for it, like the triggers).
model events {
  id              String   @id // made in the BROWSER (crypto.randomUUID()), not by the database: the page knows its opening row at once, and a retried send creates no duplicate (ON CONFLICT DO NOTHING in the writing code, next run)
  event_type      String // required: code, object_action in the past tense — contact_opened | contact_form_started | contact_form_error | contact_closed (Day 19ב). Hebrew lives on the screen only
  visitor_id      String? // see searches.visitor_id — the button's memory after a send and the behaviour analyses; NOT the lead count (the person for counting is the phone fingerprint in contact_requests). An event written without it stays anonymous for ever
  session_id      String? // see searches.session_id — one visit
  search_id       Int? // the search this happened in; null on an address without a search
  car_id          Int? // null on events not about a car
  listing_id      Int? // through which ad — the window's open and what followed; null on the rest. The lead itself and its dealer come from the request row
  car_rank        Int? // the car's place in that search — duplicated from search_results on purpose (part D §9): every analysis query needs it
  was_recommended Boolean? // whether the car was among the three — derived from recommendation_categories, stored on purpose (part D §9)
  details         Json? // what belongs to this action and not to all: contact_form_error → which field and which error (never what was typed); contact_closed → how long the window was open and whether filling had started; contact_form_started → visit or callback
  created_at      DateTime @default(now()) @db.Timestamptz(3) // the datum, not metadata: the chronological order is what tells "scrolled and came back"

  search           searches?          @relation(fields: [search_id], references: [id], onDelete: SetNull)
  car              cars?              @relation(fields: [car_id], references: [id], onDelete: SetNull)
  listing          listings?          @relation(fields: [listing_id], references: [id], onDelete: SetNull)
  contact_requests contact_requests[]

  @@index([search_id])
  @@index([listing_id])
  @@index([visitor_id, created_at])
}

// 16. contact_requests — one row per request SENT from the contact window (findCar-schema.md part A and part D §19):
// a visit (day and hour) or a callback, with name and phone. This is the lead — the dealer pays for it, not
// for the click. Kept apart from events on purpose: there, nameless actions for ever, for measurement; here, names
// and phones in one closed place with their own deletion rule (the two buyer fields are emptied after
// 6 months — built before the public opening, not now; the row and the phone fingerprint stay). The car and the
// dealer are NOT copied — they come through the listing; the price IS copied, because it changes. "Counted or not"
// is not stored — the counting code computes it from the rows, the agreement row and the feed's sale date.
// Closed to Supabase's open API (row level security on, no policy) — only the site's server reads and writes.
// Delivery-to-the-dealer columns — with Day 29's framework.
model contact_requests {
  id               Int       @id @default(autoincrement())
  created_at       DateTime  @default(now()) @db.Timestamptz(3) // the moment "שלח למוכר" was pressed
  listing_id       Int // required: which ad the request is about — the car and the dealer through it
  agreement_id     Int? // the seller's dealer_commercial row in force at that moment
  kind             String // required: code, visit | callback
  visit_at         DateTime? @db.Timestamptz(3) // the chosen day and hour, Israel time, stored as the instant; visit only
  price_at_send    Int? // listings.price at that moment — stored because it changes
  search_result_id Int? // the row the buyer saw: place and label; null only when the address carried no search
  opened_event_id  String? // the contact_opened row the request was sent from (ON DELETE SET NULL); null when the opening was not recorded — measurement never stops a send
  buyer_name       String? // emptied after 6 months
  buyer_phone      String? // digits only (0527654321); emptied after 6 months
  buyer_phone_fp   String // required: fingerprint of the phone (HMAC, server-side secret) — stays for ever; the counting rules work on it
  visitor_id       String? // the visitor cookie — the button that remembers; null when the browser keeps no cookie
  session_id       String? // one visit — for measurement

  listing       listings           @relation(fields: [listing_id], references: [id], onDelete: Restrict)
  agreement     dealer_commercial? @relation(fields: [agreement_id], references: [id], onDelete: SetNull)
  search_result search_results?    @relation(fields: [search_result_id], references: [id], onDelete: SetNull)
  opened_event  events?            @relation(fields: [opened_event_id], references: [id], onDelete: SetNull)

  @@index([listing_id])
  @@index([buyer_phone_fp])
  @@index([opened_event_id])
  @@index([visitor_id, created_at])
}

// 17. model_specs — the manual spec (Day 19ב): one row per row of the sheet tab "מפרט ידני" — dimensions, trunk, tank and fuel consumption,
// which the ministry catalog lacks. A models row points here (models.model_spec_id), set by the sheet import when make,
// model, body_type, year, engine_size, engine type and drive_type are equal and its sub_model is in sub_models.
// Required: the key a row is matched on (part E, rule 3). The numbers, the link and the date are required by the import, not the database — except the consumption of an electric or plug-in row, which has none.
model model_specs {
  id           Int       @id @default(autoincrement())
  make         String // as models.make
  model        String // as models.model — the normalized spelling
  body_type    String // as models.body_type
  year         Int // production year — one row per year
  engine_size  Int // cc, as models.engine_size
  engine_type  String // the engine type — the tab's closed list (findCar-schema.md part D §18)
  drive_type   String // "4X2" | "4X4", as models.drive_type (the tab's 2 / 4, converted at import)
  sub_models   String[] // the trims the row applies to, each exactly as models.sub_model
  length_mm    Int? // mm
  width_mm     Int? // mm, without mirrors
  height_mm    Int? // mm, as the Israeli trim comes — with roof rails when fitted
  trunk_liters Int? // rear seats in place
  tank_liters  Int? // the fuel tank; times the shown consumption = the range
  km_per_liter Float? // official fuel consumption, km per liter, as Carzone shows it; shown only when models.co2_wltp is empty — the ministry's number always wins
  carzone_url  String? // the Carzone page the numbers came from
  source_date  DateTime? @db.Date // when they were checked
  created_at   DateTime  @default(now()) @db.Timestamptz(3)

  models models[]
}
